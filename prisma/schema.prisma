generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum SimType {
  PHYSICAL
  ESIM
}

enum SimStatus {
  AVAILABLE
  ACTIVE
  SUSPENDED
  RETIRED
}

enum UsageType {
  DATA
  VOICE
  SMS
}

enum UsageEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  REJECTED
  FAILED
}

enum AllowanceSource {
  PLAN
  ADDON
  PROMOTION
}

enum AllowanceStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum OutboxEventType {
  USAGE_EVENT_RECEIVED
}

model Customer {
  id        String         @id @default(cuid())
  firstName String
  lastName  String
  email     String         @unique
  phone     String?
  status    CustomerStatus @default(ACTIVE)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id           String     @id @default(cuid())
  name         String
  description  String?
  monthlyPrice Decimal    @db.Decimal(10, 2)
  status       PlanStatus @default(ACTIVE)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id String @id @default(cuid())

  customerId String
  planId     String

  customer Customer @relation(fields: [customerId], references: [id])
  plan     Plan     @relation(fields: [planId], references: [id])

  status       SubscriptionStatus @default(PENDING)
  monthlyPrice Decimal            @db.Decimal(10, 2)

  activatedAt DateTime?
  endedAt     DateTime?
  billingDay  Int

  sim        Sim?
  allowances Allowance[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  usageEvents UsageEvent[]

  @@index([customerId])
  @@index([planId])
}

model Sim {
  id String @id @default(cuid())

  iccid  String  @unique
  msisdn String? @unique

  type   SimType
  status SimStatus @default(AVAILABLE)

  subscriptionId String?       @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  activatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Allowance {
  id String @id @default(cuid())

  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  usageType UsageType
  source    AllowanceSource

  totalAmount     Int
  remainingAmount Int

  priority Int

  startsAt  DateTime  @default(now())
  expiresAt DateTime?

  status AllowanceStatus @default(ACTIVE)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  allocations Allocation[]

  @@index([subscriptionId])
  @@index([subscriptionId, usageType, status, priority])
}

model UsageEvent {
  id String @id @default(cuid())

  externalEventId String @unique
  subscriptionId  String

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  usageType UsageType
  amount    Int

  status UsageEventStatus @default(RECEIVED)

  occurredAt  DateTime
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  failureReason String?

  allocations Allocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId, occurredAt])
  @@index([status])
}

model Allocation {
  id String @id @default(cuid())

  usageEventId String
  allowanceId  String

  usageEvent UsageEvent @relation(fields: [usageEventId], references: [id])
  allowance  Allowance  @relation(fields: [allowanceId], references: [id])

  amount Int

  createdAt DateTime @default(now())

  @@unique([usageEventId, allowanceId])
  @@index([allowanceId])
}

model OutboxEvent {
  id          String          @id @default(cuid())
  type        OutboxEventType
  aggregateId String
  payload     Json

  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())

  lockedAt DateTime?
  lockedBy String?

  publishedAt DateTime?
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
  @@index([status, lockedAt])
}
